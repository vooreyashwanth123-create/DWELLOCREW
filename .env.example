# DwelloCrew Environment Variables Example
# Duplicate this file to .env for local overrides in production environments

# Application Environment
DWELLOCREW_ENV=development
DWELLOCREW_PORT=8000
DWELLOCREW_APP_TITLE="DwelloCrew — Find. Book. Relax."

# Administrator Security Setup
# Credentials MUST NEVER be committed to version control
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD_HASH=your_sha256_password_hash_here # Replace with your SHA-256 password hash

# Financial & Platform Commission Defaults
DEFAULT_PLATFORM_COMMISSION_PERCENT=12.5
TAX_RATE_PERCENT=5.0

# Third Party Integrations (Placeholders)
WHATSAPP_BUSINESS_NUMBER=+10000000000
WHATSAPP_API_ENABLED=true
PAYMENT_GATEWAY_SANDBOX=true
PAYMENT_PUBLIC_KEY=pk_test_your_public_key_here
